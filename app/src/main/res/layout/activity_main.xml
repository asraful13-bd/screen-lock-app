<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:padding="24dp">

    <!-- App Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:text="One-Tap Screen Lock"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Tap the button below to turn off screen"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <!-- Center Big Lock Button -->
    <Button
        android:id="@+id/btnLock"
        android:layout_width="220dp"
        android:layout_height="70dp"
        android:layout_centerInParent="true"
        android:backgroundTint="#EF4444"
        android:elevation="8dp"
        android:text="🔒 LOCK SCREEN"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Clickable Developer Portfolio Footer -->
    <TextView
        android:id="@+id/tvDeveloper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:text="Developed by Md Asraful Alam ↗"
        android:textColor="#38BDF8"
        android:textSize="15sp"
        android:textStyle="bold" />

</RelativeLayout>
